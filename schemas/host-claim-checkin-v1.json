{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeksei.dev/schemas/host-claim-checkin-v1.json",
  "type": "object",
  "required": ["status", "nextWakeAt"],
  "properties": {
    "status": {
      "enum": ["idle", "claimed", "in_progress"]
    },
    "lease": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "triggerId": { "type": "string" },
        "claimedAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "recoveryOnExpiry": { "const": true }
      }
    },
    "payload": {
      "type": ["object", "null"],
      "properties": {
        "kind": { "const": "proactive_checkin" },
        "format": { "const": "plain_text" },
        "decisionOrder": {
          "type": "array",
          "items": { "type": "string" }
        },
        "bookkeepingPriorities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "observerContract": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "contextBriefing": {
      "type": ["object", "null"],
      "properties": {
        "briefingText": { "type": "string" },
        "followupContext": { "type": "string" },
        "stale": { "type": "boolean" },
        "staleReasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "bookkeepingExpectations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string" },
          "route": { "type": "string" },
          "when": { "type": "string" }
        }
      }
    },
    "pendingHandoff": {
      "type": ["object", "null"]
    },
    "proactiveDecision": {
      "type": ["object", "null"],
      "properties": {
        "kind": { "const": "proactive_decision" },
        "decisionVersion": { "const": 1 },
        "decisionId": { "type": "string" },
        "reasonCode": { "type": "string" },
        "interventionLevel": { "type": "string" },
        "confidence": { "type": "number" },
        "shouldSurface": { "type": "boolean" },
        "suggestedMessage": { "type": "string" },
        "userVisibleReason": { "type": "string" },
        "backstageActions": {
          "type": "array",
          "items": { "type": "object" }
        },
        "outputModality": { "type": "string" },
        "nextWakePolicy": { "type": "object" },
        "model": { "type": "object" }
      }
    },
    "origin": {
      "type": ["object", "null"]
    },
    "nextWakeAt": { "type": "string" }
  }
}
