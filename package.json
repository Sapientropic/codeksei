{
  "name": "codeksei",
  "version": "0.2.0",
  "description": "Local-first companion bridge for Codex, WeChat, timeline, diary, and review workflows.",
  "license": "AGPL-3.0-only",
  "private": false,
  "type": "commonjs",
  "main": "dist/src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sapientropic/codeksei.git"
  },
  "homepage": "https://github.com/Sapientropic/codeksei#readme",
  "bugs": {
    "url": "https://github.com/Sapientropic/codeksei/issues"
  },
  "bin": {
    "codeksei": "dist/src/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "templates",
    "README.en.md"
  ],
  "keywords": [
    "codeksei",
    "codex",
    "wechat",
    "weixin",
    "timeline",
    "review",
    "companion"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{ recursive:true, force:true })\"",
    "build": "tsc -p ./tsconfig.json",
    "prepare": "npm run build",
    "start": "node ./dist/src/index.js start",
    "start:checkin": "node ./dist/src/index.js start --checkin",
    "login": "node ./dist/src/index.js login",
    "accounts": "node ./dist/src/index.js accounts",
    "doctor": "node ./dist/src/index.js doctor",
    "help": "node ./dist/src/index.js help",
    "shared:start": "node ./dist/src/shared/shared-start.js",
    "shared:open": "node ./dist/src/shared/shared-open.js",
    "shared:status": "node ./dist/src/shared/shared-status.js",
    "shared:supervisor": "node ./dist/src/shared/shared-supervisor.js",
    "shared:watchdog": "node ./dist/src/shared/shared-watchdog.js",
    "background:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-background-tasks.ps1",
    "background:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/uninstall-background-tasks.ps1",
    "channel:send-file": "node ./dist/src/index.js channel send-file",
    "note:auto": "node ./dist/src/index.js note auto",
    "note:maybe": "node ./dist/src/index.js note maybe",
    "note:sync": "node ./dist/src/index.js note sync",
    "project:radar": "node ./dist/src/index.js project radar",
    "review:nightly": "node ./dist/src/index.js review nightly",
    "review:weekly": "node ./dist/src/index.js review weekly",
    "review:monthly": "node ./dist/src/index.js review monthly",
    "reminder:write": "node ./dist/src/index.js reminder write",
    "diary:write": "node ./dist/src/index.js diary write",
    "system:send": "node ./dist/src/index.js system send",
    "system:checkin": "node ./dist/src/index.js system checkin-poller",
    "timeline:event": "node ./dist/src/index.js timeline event",
    "timeline:write": "node ./dist/src/index.js timeline write",
    "timeline:read": "node ./dist/src/index.js timeline read",
    "timeline:categories": "node ./dist/src/index.js timeline categories",
    "timeline:proposals": "node ./dist/src/index.js timeline proposals",
    "timeline:build": "node ./dist/src/index.js timeline build",
    "timeline:serve": "node ./dist/src/index.js timeline serve",
    "timeline:dev": "node ./dist/src/index.js timeline dev",
    "timeline:screenshot": "node ./dist/src/index.js timeline screenshot",
    "lint": "node ./dist/src/release/check-covered-js-entrypoints.js && node ./dist/src/release/assert-no-legacy-branding.js && node ./dist/src/release/assert-no-key-ts-commonjs.js && node ./dist/src/release/assert-no-ts-nocheck-regressions.js",
    "typecheck": "tsc -p ./tsconfig.json --noEmit --pretty false",
    "typecheck:tests:ts": "tsc -p ./tsconfig.tests.json --noEmit --pretty false",
    "typecheck:strict": "npm run typecheck",
    "check": "npm run build && npm run lint && npm run typecheck && npm run typecheck:tests:ts",
    "verify": "npm run check && node --experimental-strip-types --require ./tests/helpers/build-path-resolver.js --test tests/*.test.js tests/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "qrcode-terminal": "0.12.0",
    "timeline-for-agent": "github:WenXiaoWendy/timeline-for-agent#main",
    "ws": "^8.19.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3"
  }
}
