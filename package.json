{
  "name": "codeksei",
  "version": "0.5.0",
  "description": "Local-first companion bridge for Codex, WeChat, timeline, diary, and review workflows.",
  "license": "AGPL-3.0-only",
  "private": false,
  "type": "commonjs",
  "main": "dist/src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sapientropic/codeksei.git"
  },
  "homepage": "https://github.com/Sapientropic/codeksei#readme",
  "bugs": {
    "url": "https://github.com/Sapientropic/codeksei/issues"
  },
  "bin": {
    "codeksei": "dist/src/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "schemas",
    "templates",
    "CODEKSEI_HOSTKIT.json",
    "codeksei.config.json",
    "README.en.md"
  ],
  "keywords": [
    "codeksei",
    "codex",
    "wechat",
    "weixin",
    "timeline",
    "review",
    "companion"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{ recursive:true, force:true })\"",
    "copy:timeline-assets": "tsx ./src/release/copy-timeline-assets.ts",
    "build:node": "tsc -p ./tsconfig.node.json",
    "build:web": "tsc -p ./tsconfig.web.json",
    "build": "npm run build:node && npm run build:web && npm run copy:timeline-assets",
    "start": "node ./dist/src/index.js start",
    "start:checkin": "node ./dist/src/index.js start --checkin",
    "login": "node ./dist/src/index.js login",
    "accounts": "node ./dist/src/index.js accounts",
    "doctor": "node ./dist/src/index.js doctor",
    "help": "node ./dist/src/index.js help",
    "shared:start": "node ./dist/src/shared/shared-start.js",
    "shared:open": "node ./dist/src/shared/shared-open.js",
    "shared:status": "node ./dist/src/shared/shared-status.js",
    "shared:supervisor": "node ./dist/src/shared/shared-supervisor.js",
    "shared:watchdog": "node ./dist/src/shared/shared-watchdog.js",
    "background:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-background-tasks.ps1",
    "background:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/uninstall-background-tasks.ps1",
    "channel:send-file": "node ./dist/src/index.js channel send-file",
    "companion:remember": "node ./dist/src/index.js companion remember",
    "note:auto": "node ./dist/src/index.js note auto",
    "note:maybe": "node ./dist/src/index.js note maybe",
    "note:sync": "node ./dist/src/index.js note sync",
    "onboarding:start": "node ./dist/src/index.js onboarding start",
    "onboarding:step": "node ./dist/src/index.js onboarding step",
    "onboarding:status": "node ./dist/src/index.js onboarding status",
    "onboarding:reset": "node ./dist/src/index.js onboarding reset",
    "capabilities:status": "node ./dist/src/index.js capabilities status",
    "context:briefing": "node ./dist/src/index.js context briefing",
    "context:inspect": "node ./dist/src/index.js context inspect",
    "whereabouts:serve": "node ./dist/src/index.js whereabouts serve",
    "whereabouts:snapshot": "node ./dist/src/index.js whereabouts snapshot",
    "whereabouts:recent-stays": "node ./dist/src/index.js whereabouts recent-stays",
    "whereabouts:recent-moves": "node ./dist/src/index.js whereabouts recent-moves",
    "whereabouts:summary": "node ./dist/src/index.js whereabouts summary",
    "proactive:observe": "node ./dist/src/index.js proactive observe",
    "proactive:eval": "node ./dist/src/index.js proactive eval",
    "pulse:today": "node ./dist/src/index.js pulse today",
    "pulse:generate": "node ./dist/src/index.js pulse generate",
    "pulse:feedback": "node ./dist/src/index.js pulse feedback",
    "project:radar": "node ./dist/src/index.js project radar",
    "review:nightly": "node ./dist/src/index.js review nightly",
    "review:weekly": "node ./dist/src/index.js review weekly",
    "review:monthly": "node ./dist/src/index.js review monthly",
    "reminder:write": "node ./dist/src/index.js reminder write",
    "diary:write": "node ./dist/src/index.js diary write",
    "system:checkin-trigger": "node ./dist/src/index.js system checkin-trigger",
    "system:checkin-tick": "node ./dist/src/index.js system checkin-tick",
    "system:checkin-complete": "node ./dist/src/index.js system checkin-complete",
    "timeline:event": "node ./dist/src/index.js timeline event",
    "timeline:write": "node ./dist/src/index.js timeline write",
    "timeline:read": "node ./dist/src/index.js timeline read",
    "timeline:categories": "node ./dist/src/index.js timeline categories",
    "timeline:proposals": "node ./dist/src/index.js timeline proposals",
    "timeline:build": "node ./dist/src/index.js timeline build",
    "timeline:serve": "node ./dist/src/index.js timeline serve",
    "timeline:dev": "node ./dist/src/index.js timeline dev",
    "frame:build": "node ./dist/src/index.js frame build",
    "frame:serve": "node ./dist/src/index.js frame serve",
    "frame:dev": "node ./dist/src/index.js frame dev",
    "timeline:screenshot": "node ./dist/src/index.js timeline screenshot",
    "smoke:shared:real:attach": "node ./dist/src/maintainer/shared-real-smoke.js attach",
    "smoke:shared:real:reply": "node ./dist/src/maintainer/shared-real-smoke.js reply",
    "smoke:shared:real:approval": "node ./dist/src/maintainer/shared-real-smoke.js approval",
    "lint": "tsx ./src/release/assert-no-authored-js-extensions.ts && tsx ./src/release/assert-published-runtime-artifacts.ts && tsx ./src/release/assert-no-js-tests.ts && tsx ./src/release/assert-no-legacy-branding.ts && tsx ./src/release/assert-no-key-ts-commonjs.ts && tsx ./src/release/assert-no-typed-module-destructure.ts && tsx ./src/release/assert-no-ts-nocheck-regressions.ts && tsx ./src/release/assert-no-empty-catch.ts && tsx ./src/release/assert-no-duplicate-normalize-text.ts && tsx ./src/release/assert-no-redundant-typed-aliases.ts && tsx ./src/release/assert-no-definite-assignment.ts && tsx ./src/release/assert-no-explicit-any.ts && tsx ./src/release/assert-no-core-imports-adapters.ts && tsx ./src/release/assert-no-production-console.ts && tsx ./src/release/assert-hostkit-sync.ts",
    "audit:prod": "tsx ./src/release/run-prod-audit-gate.ts",
    "audit:prod:raw": "npm audit --omit=dev",
    "audit:prod:json": "npm audit --omit=dev --json",
    "sync:hostkit": "tsx ./src/release/sync-hostkit.ts",
    "typecheck:node": "tsc -p ./tsconfig.node.json --noEmit --pretty false",
    "typecheck:web": "tsc -p ./tsconfig.web.json --noEmit --pretty false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:tests:ts": "tsc -p ./tsconfig.tests.json --noEmit --pretty false",
    "typecheck:strict-libs:node": "tsc -p ./tsconfig.strict-libs.node.json --noEmit --pretty false",
    "typecheck:strict-libs:web": "tsc -p ./tsconfig.strict-libs.web.json --noEmit --pretty false",
    "typecheck:strict-libs:tests": "tsc -p ./tsconfig.strict-libs.tests.json --noEmit --pretty false",
    "typecheck:strict-libs": "npm run typecheck:strict-libs:node && npm run typecheck:strict-libs:web && npm run typecheck:strict-libs:tests",
    "typecheck:strict": "npm run typecheck:strict-libs",
    "check": "npm run lint && npm run typecheck && npm run typecheck:tests:ts",
    "coverage:critical": "tsx ./src/release/run-critical-coverage.ts",
    "test:built-runtime": "tsx ./src/release/run-built-runtime-tests.ts",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts",
    "smoke:package": "tsx ./src/release/smoke-package.ts",
    "verify": "npm run check && npm run coverage:critical && npm run build && npm run test:built-runtime && npm run pack:dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "^2.2.6",
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.59.1",
    "qrcode-terminal": "0.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "vis-timeline": "^8.5.0",
    "ws": "^8.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
