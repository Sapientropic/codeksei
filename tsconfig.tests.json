{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "moduleDetection": "force"
  },
  "include": [
    "src/**/*",
    "tests/helpers/**/*.js",
    "tests/app-approval-policy.test.ts",
    "tests/check-coverage-contract.test.ts",
    "tests/cli-arg-parser.test.ts",
    "tests/command-registry.test.ts",
    "tests/command-surface-contract.test.ts",
    "tests/config-loader.test.ts",
    "tests/queue-item-contract.test.ts",
    "tests/root-helper-smoke.test.ts",
    "tests/system-message-queue-store.test.ts",
    "tests/workspace-bootstrap.test.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
