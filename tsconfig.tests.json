{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "moduleDetection": "force"
  },
  "include": [
    "src/**/*",
    "tests/**/*.test.ts",
    "tests/helpers/**/*.ts",
    "tests/helpers/**/*.js"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
